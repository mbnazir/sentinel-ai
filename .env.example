APP_NAME=Sentinel AI
APP_VERSION=0.13.0
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
DOCS_ENABLED=false
LOG_LEVEL=INFO
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_ai
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=REPLACE_FROM_SECRET_STORE
REDIS_URL=redis://redis:6379/0
JWT_SECRET=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=30
JWT_AUDIENCE=sentinel-ai-api
CORS_ORIGINS=https://sentinel.example.internal
SECURITY_HEADERS_ENABLED=true
QUARTZ_API_BEARER_TOKEN=REPLACE_FROM_SECRET_STORE

AI_PROVIDER=disabled
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
